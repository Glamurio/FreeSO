+        private void BumpRoomObjects(VMEntity obj, ushort room)
+        {
+            if (!(obj is VMGameObject) || obj.Container != null || obj.Footprint == null) return;
+            if (room < RoomObjectVersion.Length) RoomObjectVersion[room]++;
+        }
